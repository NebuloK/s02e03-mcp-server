# Port to run the server on (Render sets this automatically)
PORT=3000

# Base public URL of the server (set by Render or manually)
# Example: BASE_URL=https://your-app.onrender.com
BASE_URL=http://localhost:3000

# Static auth token for testing (fallback when no OAuth flow is used)
AUTH_TOKEN=your-secret-token-here

# AssemblyAI API key for transcription
# Get one free at https://www.assemblyai.com (no credit card required)
ASSEMBLYAI_API_KEY=your-assemblyai-key-here
